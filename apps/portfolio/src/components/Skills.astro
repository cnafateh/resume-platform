---
import { data } from "../data/resume";

const skills = data.skills ?? [];
---

<section
  id="skills"
  class="section-shell reveal py-24"
>

  <div class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-neutral-500">
      Toolkit
    </p>

    <h2
      class="
        mt-3
        text-3xl
        font-semibold
        text-neutral-950
        dark:text-white
      "
    >
      Skills
    </h2>
  </div>

  <div class="grid gap-8 md:grid-cols-2">

    {
      skills.map((group) => (

        <article
          class="
            motion-card
            rounded-2xl
            border
            border-black/10
            bg-black/[0.02]
            p-6

            dark:border-white/10
            dark:bg-white/[0.025]
          "
        >

          <h3
            class="
              font-medium
              text-neutral-950
              dark:text-white
            "
          >
            {group.name}
          </h3>

          <div class="mt-4 flex flex-wrap gap-2">

            {group.keywords.map((skill) => (

              <span
                class="
                  rounded-full
                  border
                  border-black/10
                  px-3 py-1
                  font-mono
                  text-xs
                  text-neutral-600

                  dark:border-white/10
                  dark:text-neutral-400
                "
              >
                {skill}
              </span>

            ))}

          </div>

        </article>

      ))
    }

  </div>
</section>