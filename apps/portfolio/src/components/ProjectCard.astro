---
import {
  ExternalLink,
  Github,
  Container
} from "lucide-astro";

interface Props {
  project: any;
}

const { project } = Astro.props;

const github = project.links?.github;
const live = project.links?.live;
---

<article
  class="
    motion-card
    rounded-3xl
    border
    border-black/10
    bg-black/[0.02]
    p-7

    dark:border-white/10
    dark:bg-white/[0.025]

    hover:border-black/20
    dark:hover:border-white/20
  "
>

  <div class="flex items-start justify-between gap-4">

    <h3
      class="
        text-xl
        font-medium
        text-neutral-950
        dark:text-white
      "
    >
      {project.name}
    </h3>

    {
      project.deployment?.dockerized && (
        <span
          title="Dockerized"
          class="
            flex size-8
            items-center
            justify-center
            rounded-full
            border
            border-black/10
            text-neutral-500

            dark:border-white/10
            dark:text-neutral-400
          "
        >
          <Container size={15} />
        </span>
      )
    }

  </div>

  <p
    class="
      mt-5
      leading-7
      text-neutral-600
      dark:text-neutral-400
    "
  >
    {project.description}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">

    {
      project.keywords?.map((tech: string) => (
        <span
          class="
            rounded-full
            border
            border-black/10
            px-2.5 py-1
            font-mono
            text-xs
            text-neutral-500

            dark:border-white/10
            dark:text-neutral-500
          "
        >
          {tech}
        </span>
      ))
    }

  </div>

  <div
    class="
      mt-8
      flex items-center
      gap-4
      border-t
      border-black/10
      pt-5
      dark:border-white/10
    "
  >

    {
      live && (
        <a
          href={live}
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex
            items-center
            gap-1.5
            text-sm
            font-medium
            text-neutral-900
            hover:underline

            dark:text-white
          "
        >
          View project
          <ExternalLink size={14} />
        </a>
      )
    }

    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex
            items-center
            gap-1.5
            text-sm
            text-neutral-500
            hover:text-neutral-900
            dark:hover:text-white
          "
        >
          <Github size={14} />
          Source
        </a>
      )
    }

  </div>

</article>