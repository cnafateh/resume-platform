---
import { data } from "../data/resume";
import { projects, topics } from "../data/seo";
import CursorObserver from "./CursorObserver.astro";
import PortfolioMotion from "./PortfolioMotion.astro";

const { basics } = data;
const work = data.work ?? [];
const skills = data.skills ?? [];
const education = data.education ?? [];
const certificates = data.certificates ?? [];
const initials = basics.name.split(/\s+/).map((part) => part[0]).join("").slice(0, 2);
const location = [basics.location?.city, basics.location?.countryCode].filter(Boolean).join(", ");
const primarySkills = skills.flatMap((group) => group.keywords ?? []).filter((item, index, all) => all.indexOf(item) === index).slice(0, 8);
const shortSummary = (basics.summary ?? basics.about).split(". ").slice(0, 2).join(". ");
---

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="site-frame">
  <header class="site-header" id="top">
    <a href="#top" class="brand" aria-label={`${basics.name}, back to top`}><span class="brand-symbol" aria-hidden="true">{initials}<i></i></span><span class="brand-copy"><strong>{basics.name}</strong><small>SOFTWARE / SYSTEMS</small></span></a>
    <nav class="desktop-nav" aria-label="Main navigation"><a href="#about">About</a><a href="#work">Work</a><a href="#expertise">Expertise</a><a href="#experience">Journey</a><a href="#contact">Contact</a></nav>
    <div class="header-actions"><a class="header-cv" href="https://cv.sinafateh.ir/">View CV <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden><a href="#about">About</a><a href="#work">Work</a><a href="#expertise">Expertise</a><a href="#experience">Journey</a><a href="#contact">Contact</a><a class="nav-secondary" href="https://cv.sinafateh.ir/">CV ↗</a></nav>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <div class="eyebrow"><span class="eyebrow-line"></span>{location} <span class="eyebrow-dot">/</span> PORTFOLIO</div>
        <p class="hero-intro">Hi, I’m <strong>{basics.name}</strong></p>
        <h1 id="hero-title">Building<br /><em>what’s next</em><span class="hero-period">.</span></h1>
        <p class="hero-description">I build maintainable web applications, backend services, and the infrastructure that runs them.</p>
        <div class="hero-cta"><a class="button-primary" href="#work">Explore selected work <span aria-hidden="true">↗</span></a><a class="text-link" href={`mailto:${basics.email}`}>Let’s connect <span aria-hidden="true">↗</span></a></div>
        <div class="hero-signals"><span><i></i> ENGINEERING</span><span><i></i> BACKEND</span><span><i></i> INFRASTRUCTURE</span></div>
      </div>
      <div class="scene-wrap" aria-label="Interactive spatial illustration of connected application layers">
        <div class="scene-glow" aria-hidden="true"></div>
        <div class="scene" id="architecture-scene" aria-hidden="true">
          <div class="scene-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="architecture">
            <div class="architecture-layer layer-back"><span class="layer-index">03 / DELIVERY</span><span class="layer-pattern pattern-dots"></span><span class="layer-corner">◈</span></div>
            <div class="architecture-layer layer-mid"><span class="layer-index">02 / LOGIC</span><span class="layer-pattern pattern-lines"></span><span class="layer-corner">✳</span></div>
            <div class="architecture-layer layer-front"><span class="layer-index">01 / SYSTEM</span><span class="layer-core"><span>{initials}</span><i></i></span><span class="layer-bottom">DESIGN / BUILD / SHIP</span></div>
            <div class="scene-connector connector-one"></div><div class="scene-connector connector-two"></div>
          </div>
          <span class="scene-coordinate coordinate-top">SYS.01 — ACTIVE</span><span class="scene-coordinate coordinate-bottom">{basics.name.toUpperCase()}</span>
        </div>
        <div class="scene-note"><span class="note-square"></span> IDEAS INTO SYSTEMS <span>01 / 04</span></div>
      </div>
      <div class="hero-rail" aria-hidden="true"><span>SCROLL TO EXPLORE</span><i></i><span>↓</span></div>
    </section>

    <div class="signal-strip" aria-label="Technical focus"><span class="signal-label">WHAT I WORK WITH</span><div class="signal-items">{primarySkills.map((skill) => <span>{skill}</span>)}</div></div>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="section-heading reveal"><span class="section-num">01 / ABOUT</span><span class="section-rule"></span><span class="section-aside">A PERSON BEHIND THE SYSTEMS</span></div>
      <div class="about-grid"><div><h2 id="about-title" class="display-heading reveal">Thoughtful code.<br /><em>Real-world impact.</em></h2><CursorObserver lang="en" /></div><div class="about-copy reveal"><p>{shortSummary}</p><div class="about-meta"><div><span>BASED IN</span><strong>{location}</strong></div><div><span>FOCUS</span><strong>{basics.label}</strong></div></div><a href="https://cv.sinafateh.ir/" class="inline-arrow">Read the full CV <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="section-heading reveal"><span class="section-num">02 / SELECTED WORK</span><span class="section-rule"></span><span class="section-aside">BUILT TO BE USED</span></div>
      <div class="section-title-row reveal"><div><h2 id="work-title" class="display-heading">Work in <em>practice.</em></h2></div><p>From product backends to the infrastructure that keeps them running. Explore the decisions and technologies behind each project.</p></div>
      <div class="project-list">{projects.map((project, index) => <article class="project-feature reveal" style={`--project-index:${index % 4}`}><a class="project-visual" href={project.href} aria-label={`Explore ${project.name}`}><span class="project-visual-top"><span>PROJECT / {String(index + 1).padStart(2, "0")}</span><span>↗</span></span><div class="project-glyph"><span class="glyph-frame glyph-frame-a"></span><span class="glyph-frame glyph-frame-b"></span><span class="glyph-center">{String(index + 1).padStart(2, "0")}</span></div><span class="project-visual-bottom">{project.keywords?.slice(0, 2).join(" / ") || "SOFTWARE SYSTEM"}</span></a><div class="project-content"><div class="project-overline"><span>CASE STUDY {String(index + 1).padStart(2, "0")}</span><span class="project-line"></span></div><h3><a href={project.href}>{project.name}</a></h3><p>{project.description}</p><ul class="project-tags">{project.keywords?.slice(0, 5).map((keyword) => <li>{keyword}</li>)}</ul><div class="project-actions"><a href={project.href} class="inline-arrow">Explore project <span aria-hidden="true">↗</span></a>{project.links?.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}{project.links?.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">Code ↗</a>}</div></div></article>)}</div>
    </section>

    <section class="section expertise-section" id="expertise" aria-labelledby="expertise-title">
      <div class="section-heading reveal"><span class="section-num">03 / EXPERTISE</span><span class="section-rule"></span><span class="section-aside">THE TOOLKIT</span></div>
      <div class="expertise-layout"><div class="expertise-intro reveal"><h2 id="expertise-title" class="display-heading">An adaptable<br /><em>toolkit.</em></h2><p>Organized by the problems I work on, from application architecture to deployment and troubleshooting.</p><div class="expertise-marker" aria-hidden="true"><span>✳</span><i></i></div></div><div class="capability-list">{skills.map((group, index) => <details class="capability reveal" open={index === 0}><summary><span class="capability-index">{String(index + 1).padStart(2, "0")}</span><h3>{group.name}</h3><span class="capability-count">{group.keywords?.length ?? 0} SKILLS</span><span class="capability-toggle" aria-hidden="true">+</span></summary><ul>{group.keywords?.map((skill) => <li>{skill}</li>)}</ul></details>)}</div></div>
    </section>

    <section class="section journey-section" id="experience" aria-labelledby="journey-title">
      <div class="section-heading reveal"><span class="section-num">04 / JOURNEY</span><span class="section-rule"></span><span class="section-aside">EXPERIENCE & LEARNING</span></div>
      <div class="journey-grid"><div class="reveal"><h2 id="journey-title" class="display-heading">Always<br /><em>in motion.</em></h2><p class="journey-lead">Roles, study, and continued learning behind the work.</p></div><div class="journey-content"><h3 class="journey-subtitle">Experience <span>{String(work.length).padStart(2, "0")}</span></h3><div class="timeline">{work.map((job) => <article class="timeline-item reveal"><div class="timeline-date">{job.startDate} — {job.endDate ?? "Present"}</div><div><h4>{job.position}</h4><p class="timeline-place">{job.url ? <a href={job.url} target="_blank" rel="noopener noreferrer">{job.name} ↗</a> : job.name}</p>{job.summary && <p class="timeline-summary">{job.summary}</p>}{job.highlights?.length > 0 && <ul class="timeline-highlights">{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}</div></article>)}</div><h3 class="journey-subtitle">Education <span>{String(education.length).padStart(2, "0")}</span></h3><div class="timeline">{education.map((item) => <article class="timeline-item reveal"><div class="timeline-date">{item.startDate} — {item.endDate ?? "Present"}</div><div><h4>{[item.studyType, item.area].filter(Boolean).join(" · ")}</h4><p class="timeline-place">{item.institution}</p></div></article>)}</div><h3 class="journey-subtitle">Continued learning <span>{String(certificates.length).padStart(2, "0")}</span></h3><div class="certificate-list">{certificates.map((certificate) => <article class="certificate-item reveal"><div><h4>{certificate.name}</h4><p>{certificate.issuer}</p></div><span>{certificate.status ?? certificate.date}</span></article>)}</div></div></div>
    </section>

    <section class="section notes-section" aria-labelledby="notes-title"><div class="section-heading reveal"><span class="section-num">05 / FIELD NOTES</span><span class="section-rule"></span><span class="section-aside">IDEAS & IMPLEMENTATION</span></div><div class="section-title-row reveal"><div><h2 id="notes-title" class="display-heading">The thinking<br /><em>behind the work.</em></h2></div><p>Short, practical notes on the technologies and decisions represented in my projects.</p></div><div class="notes-grid">{topics.map((topic, index) => <a class="note-item reveal" href={`/topics/${topic.slug}/`}><span>{String(index + 1).padStart(2, "0")} / NOTE</span><h3>{topic.title}</h3><p>{topic.description}</p><span class="note-arrow" aria-hidden="true">↗</span></a>)}</div></section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-orbit" aria-hidden="true"></div><div class="contact-inner"><h2 id="contact-title">Have something<br /><em>worth building?</em></h2><p>Let’s talk about software, systems, and the ideas behind them.</p><a class="contact-email" href={`mailto:${basics.email}`}>{basics.email} <span aria-hidden="true">↗</span></a><div class="contact-links">{basics.profiles?.map((profile) => <a href={profile.url} target="_blank" rel="me noopener noreferrer">{profile.network} ↗</a>)}<a href="https://cv.sinafateh.ir/">CV ↗</a></div></div></section>
  </main>

  <footer class="site-footer"><div><a href="#top" class="footer-brand">{basics.name} <span>↗</span></a><p>Designed to connect ideas, code, and real-world use.</p></div><div class="footer-right"><a href="/fa/" lang="fa" dir="rtl">فارسی</a><span>© {new Date().getFullYear()} {basics.name}</span><a href="#top">Back to top ↑</a></div></footer>
</div>

<PortfolioMotion lang="en" />

<script>
  document.documentElement.classList.add("portfolio-enhanced");
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = document.querySelector<HTMLElement>(".mobile-nav");
  const closeMenu = () => { if (!menuButton || !mobileNav) return; menuButton.setAttribute("aria-expanded", "false"); menuButton.setAttribute("aria-label", "Open navigation"); mobileNav.hidden = true; document.body.classList.remove("menu-open"); };
  menuButton?.addEventListener("click", () => { if (!mobileNav) return; const opening = mobileNav.hidden; mobileNav.hidden = !opening; document.body.classList.toggle("menu-open", opening); menuButton.setAttribute("aria-expanded", String(opening)); menuButton.setAttribute("aria-label", opening ? "Close navigation" : "Open navigation"); });
  mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  mobileNav?.addEventListener("click", (event) => { if (event.target === mobileNav) closeMenu(); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });

  const scene = document.querySelector<HTMLElement>("#architecture-scene");
  const sceneWrap = document.querySelector<HTMLElement>(".scene-wrap");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let frame = 0;
  if (scene && sceneWrap && finePointer.matches && !reducedMotion.matches) {
    sceneWrap.addEventListener("pointermove", (event) => { const rect = sceneWrap.getBoundingClientRect(); const x = (event.clientX - rect.left) / rect.width - 0.5; const y = (event.clientY - rect.top) / rect.height - 0.5; cancelAnimationFrame(frame); frame = requestAnimationFrame(() => { scene.style.setProperty("--scene-x", `${x * 14}deg`); scene.style.setProperty("--scene-y", `${y * -12}deg`); scene.style.setProperty("--light-x", `${(x + 0.5) * 100}%`); scene.style.setProperty("--light-y", `${(y + 0.5) * 100}%`); }); }, { passive: true });
    sceneWrap.addEventListener("pointerleave", () => { cancelAnimationFrame(frame); scene.style.setProperty("--scene-x", "0deg"); scene.style.setProperty("--scene-y", "0deg"); });
  }
  const revealItems = document.querySelectorAll<HTMLElement>(".portfolio-v2 .reveal");
  if ("IntersectionObserver" in window && !reducedMotion.matches) { const observer = new IntersectionObserver((entries) => { for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } }, { threshold: 0.06, rootMargin: "0px 0px -30px 0px" }); revealItems.forEach((item) => observer.observe(item)); }
  else revealItems.forEach((item) => item.classList.add("is-visible"));
</script>
