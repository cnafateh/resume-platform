---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Certificates from "../components/Certificates.astro";
import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Dock from "../components/Dock.astro";
import { topics } from "../data/seo";
---

<Layout homeAlternate>

  <main>

    <Hero />

    <Experience />

    <Skills />

    <Projects />

    <Certificates />

    <Education />

    <Contact />

    <section class="section-shell py-20" aria-labelledby="explore-heading">
      <p class="font-mono text-xs uppercase tracking-widest text-neutral-500">Explore</p>
      <h2 id="explore-heading" class="mt-3 text-3xl font-semibold">Sina Fateh: engineering notes and projects</h2>
      <p class="mt-5 max-w-3xl leading-8 text-neutral-600 dark:text-neutral-400">I’m Sina Fateh, also known as cnafateh. These short, practical notes connect my work in software engineering, ASP.NET Core, backend APIs, and Docker deployment to the projects shown above.</p>
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        {topics.map((topic) => <a class="motion-card rounded-2xl border border-black/10 p-6 dark:border-white/10" href={`/topics/${topic.slug}/`}><h3 class="text-lg font-semibold">{topic.title}</h3><p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">{topic.description}</p></a>)}
      </div>
      <p class="mt-8 text-sm text-neutral-600 dark:text-neutral-400">فارسی می‌خوانید؟ <a class="underline" href="/fa/" lang="fa">درباره سینا فاتح و پروژه‌هایش به فارسی</a></p>
    </section>

  </main>

  <Dock />

</Layout>
