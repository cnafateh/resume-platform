---
import Layout from "../../layouts/Layout.astro";
import { data } from "../../data/resume";
import { projects, topics } from "../../data/seo";
import { faCertificate, faDate, faEducation, faIssuer, faJob, faName, faProject, faProjectPath, faSkillGroup, faTopic, faTopicPath } from "../../data/fa";
import "@fontsource-variable/vazirmatn/wght.css";
import "../../styles/portfolio-experience.css";
import "../../styles/portfolio-fa.css";

const { basics } = data;
const skills = data.skills ?? [];
const work = data.work ?? [];
const education = data.education ?? [];
const certificates = data.certificates ?? [];
const primarySkills = skills.flatMap((group) => group.keywords ?? []).filter((item, index, all) => all.indexOf(item) === index).slice(0, 8);
---

<Layout lang="fa" homeAlternate bodyClass="portfolio-v2 fa-page" title="سینا فاتح | مهندس نرم‌افزار، ASP.NET Core و Docker" description="وب‌سایت شخصی سینا فاتح، Sina Fateh یا cnafateh؛ پروژه‌ها، تجربه‌ها و یادداشت‌های فنی در مهندسی نرم‌افزار، ASP.NET Core، بک‌اند و Docker.">
  <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
  <div class="site-frame">
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="سینا فاتح، بازگشت به بالای صفحه"><span class="brand-symbol" aria-hidden="true">SF<i></i></span><span class="brand-copy"><strong>{faName}</strong><small dir="ltr" lang="en">SINA FATEH / CNAFATEH</small></span></a>
      <nav class="desktop-nav" aria-label="ناوبری اصلی"><a href="#about">دربارهٔ من</a><a href="#work">پروژه‌ها</a><a href="#expertise">تخصص‌ها</a><a href="#experience">مسیر حرفه‌ای</a><a href="#notes">یادداشت‌ها</a><a href="#contact">ارتباط</a></nav>
      <div class="header-actions"><a class="language-link" href="/" lang="en" dir="ltr" aria-label="English version">EN</a><a class="header-cv" href="https://cv.sinafateh.ir/">مشاهدهٔ رزومه <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-label="باز کردن فهرست" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="ناوبری موبایل" hidden><a href="#about">دربارهٔ من</a><a href="#work">پروژه‌ها</a><a href="#expertise">تخصص‌ها</a><a href="#experience">مسیر حرفه‌ای</a><a href="#notes">یادداشت‌ها</a><a href="#contact">ارتباط</a><a href="https://cv.sinafateh.ir/">رزومه ↗</a><a href="/" lang="en" dir="ltr">English ↗</a></nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-text">
          <div class="eyebrow"><span class="eyebrow-line"></span>تهران، ایران <span class="eyebrow-dot">/</span> وب‌سایت شخصی</div>
          <p class="hero-intro">سلام، من <strong>{faName}</strong> هستم.</p>
          <h1 id="hero-title">ایده‌ها را به<br /><em>سیستم تبدیل می‌کنم</em><span class="hero-period">.</span></h1>
          <p class="hero-description">مهندس نرم‌افزار و توسعه‌دهندهٔ وب با تمرکز بر <bdi>ASP.NET Core</bdi>، بک‌اند و استقرار سرویس‌ها. از طراحی منطق برنامه تا اجرای آن روی سرور، به ساخت محصولاتی فکر می‌کنم که در عمل کار کنند و قابل نگهداری بمانند.</p>
          <div class="hero-cta"><a class="button-primary" href="#work">دیدن پروژه‌ها <span aria-hidden="true">↗</span></a><a class="text-link" href={`mailto:${basics.email}`}>گفت‌وگو کنیم <span aria-hidden="true">↗</span></a></div>
          <div class="hero-signals"><span><i></i> مهندسی نرم‌افزار</span><span><i></i> بک‌اند</span><span><i></i> زیرساخت</span></div>
        </div>
        <div class="scene-wrap" aria-label="تصویر سه‌بعدی لایه‌های یک سامانهٔ نرم‌افزاری">
          <div class="scene-glow" aria-hidden="true"></div>
          <div class="scene" id="architecture-scene" aria-hidden="true">
            <div class="scene-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="architecture"><div class="architecture-layer layer-back"><span class="layer-index">03 / استقرار</span><span class="layer-pattern pattern-dots"></span><span class="layer-corner">◈</span></div><div class="architecture-layer layer-mid"><span class="layer-index">02 / منطق</span><span class="layer-pattern pattern-lines"></span><span class="layer-corner">✳</span></div><div class="architecture-layer layer-front"><span class="layer-index">01 / سیستم</span><span class="layer-core"><span>SF</span><i></i></span><span class="layer-bottom">طراحی / توسعه / اجرا</span></div><div class="scene-connector connector-one"></div><div class="scene-connector connector-two"></div></div>
            <span class="scene-coordinate coordinate-top" dir="ltr">SYS.01 — ACTIVE</span><span class="scene-coordinate coordinate-bottom" dir="ltr">SINA FATEH</span>
          </div>
          <div class="scene-note"><span class="note-square"></span> از ایده تا سیستم <span dir="ltr">01 / 04</span></div>
        </div>
        <div class="hero-rail" aria-hidden="true"><span>برای دیدن بیشتر پایین بروید</span><i></i><span>↓</span></div>
      </section>

      <div class="signal-strip" aria-label="فناوری‌های اصلی"><span class="signal-label">ابزارهایی که با آن‌ها کار می‌کنم</span><div class="signal-items">{primarySkills.map((skill) => <span dir="ltr">{skill}</span>)}</div></div>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="section-heading reveal"><span class="section-num">۰۱ / دربارهٔ من</span><span class="section-rule"></span><span class="section-aside">آدمی پشت سیستم‌ها</span></div>
        <div class="about-grid"><div><p class="section-kicker reveal">آشنایی کوتاه</p><h2 id="about-title" class="display-heading reveal">کدِ سنجیده.<br /><em>اثر واقعی.</em></h2></div><div class="about-copy reveal"><p>من سینا فاتح هستم. در توسعهٔ برنامه‌های وب، سرویس‌های بک‌اند و زیرساخت اجرای آن‌ها کار می‌کنم. تمرکزم بر <bdi>C#</bdi>، <bdi>.NET</bdi> و <bdi>ASP.NET Core</bdi> است و در پروژه‌هایم از <bdi>Python</bdi>، <bdi>Django</bdi>، <bdi>PostgreSQL</bdi>، <bdi>Docker</bdi> و <bdi>Linux</bdi> هم استفاده کرده‌ام.</p><div class="about-meta"><div><span>موقعیت</span><strong>تهران، ایران</strong></div><div><span>حوزهٔ فعالیت</span><strong>مهندسی نرم‌افزار و توسعهٔ وب</strong></div></div><a href="https://cv.sinafateh.ir/" class="inline-arrow">مشاهدهٔ رزومهٔ کامل <span aria-hidden="true">↗</span></a></div></div>
      </section>

      <section class="section work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading reveal"><span class="section-num">۰۲ / پروژه‌ها</span><span class="section-rule"></span><span class="section-aside">از ایده تا اجرا</span></div>
        <div class="section-title-row reveal"><div><p class="section-kicker">فهرست پروژه‌ها</p><h2 id="work-title" class="display-heading">کارهایی که<br /><em>ساخته‌ام.</em></h2></div><p>از بک‌اند محصول تا زیرساختی که آن را اجرا می‌کند. جزئیات هر پروژه، فناوری‌های آن و پیوندهای مرتبط را در صفحهٔ اختصاصی‌اش ببینید.</p></div>
        <div class="project-list">{projects.map((project, index) => { const copy = faProject(project.slug, project.name, project.description); const href = faProjectPath(project.slug); return <article class="project-feature reveal" style={`--project-index:${index % 4}`}><a class="project-visual" href={href} aria-label={`مشاهدهٔ پروژهٔ ${copy.title}`}><span class="project-visual-top"><span>پروژه / {String(index + 1).padStart(2, "0")}</span><span>↗</span></span><div class="project-glyph"><span class="glyph-frame glyph-frame-a"></span><span class="glyph-frame glyph-frame-b"></span><span class="glyph-center">{String(index + 1).padStart(2, "0")}</span></div><span class="project-visual-bottom" dir="ltr">{project.keywords?.slice(0, 2).join(" / ") || "SOFTWARE SYSTEM"}</span></a><div class="project-content"><div class="project-overline"><span>مطالعهٔ پروژه {String(index + 1).padStart(2, "0")}</span><span class="project-line"></span></div><h3><a href={href}>{copy.title}</a></h3><p>{copy.description}</p><ul class="project-tags">{project.keywords?.slice(0, 5).map((keyword) => <li dir="ltr">{keyword}</li>)}</ul><div class="project-actions"><a href={href} class="inline-arrow">جزئیات پروژه <span aria-hidden="true">↗</span></a>{project.links?.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">نسخهٔ زنده ↗</a>}{project.links?.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">کد پروژه ↗</a>}</div></div></article>; })}</div>
      </section>

      <section class="section expertise-section" id="expertise" aria-labelledby="expertise-title">
        <div class="section-heading reveal"><span class="section-num">۰۳ / تخصص‌ها</span><span class="section-rule"></span><span class="section-aside">جعبه‌ابزار من</span></div>
        <div class="expertise-layout"><div class="expertise-intro reveal"><p class="section-kicker">توانمندی‌ها</p><h2 id="expertise-title" class="display-heading">ابزار مناسب<br /><em>برای هر مسئله.</em></h2><p>مهارت‌ها را بر اساس کاری که با آن‌ها انجام می‌دهم دسته‌بندی کرده‌ام؛ از معماری و داده تا استقرار و عیب‌یابی.</p><div class="expertise-marker" aria-hidden="true"><span>✳</span><i></i></div></div><div class="capability-list">{skills.map((group, index) => <details class="capability reveal" open={index === 0}><summary><span class="capability-index">{String(index + 1).padStart(2, "0")}</span><h3>{faSkillGroup(group.name)}</h3><span class="capability-count">{group.keywords?.length ?? 0} مهارت</span><span class="capability-toggle" aria-hidden="true">+</span></summary><ul>{group.keywords?.map((skill) => <li dir="ltr">{skill}</li>)}</ul></details>)}</div></div>
      </section>

      <section class="section journey-section" id="experience" aria-labelledby="journey-title">
        <div class="section-heading reveal"><span class="section-num">۰۴ / مسیر حرفه‌ای</span><span class="section-rule"></span><span class="section-aside">کار و یادگیری</span></div>
        <div class="journey-grid"><div class="reveal"><p class="section-kicker">پیشینه</p><h2 id="journey-title" class="display-heading">یادگیریِ<br /><em>همیشه در جریان.</em></h2><p class="journey-lead">تجربه‌های شغلی، تحصیلات و دوره‌هایی که پشت کارهای من قرار دارند.</p></div><div class="journey-content"><h3 class="journey-subtitle">تجربهٔ کاری <span>{String(work.length).padStart(2, "0")}</span></h3><div class="timeline">{work.map((job) => { const copy = faJob(job.name); return <article class="timeline-item reveal"><div class="timeline-date" dir="ltr">{job.startDate} — {faDate(job.endDate)}</div><div><h4>{copy.role || job.position}</h4><p class="timeline-place">{job.url ? <a href={job.url} target="_blank" rel="noopener noreferrer">{copy.place} ↗</a> : copy.place}</p><p class="timeline-summary">{copy.summary || job.summary}</p><ul class="timeline-highlights">{(copy.highlights.length ? copy.highlights : job.highlights ?? []).map((highlight) => <li>{highlight}</li>)}</ul></div></article>; })}</div><h3 class="journey-subtitle">تحصیلات <span>{String(education.length).padStart(2, "0")}</span></h3><div class="timeline">{education.map((item) => { const copy = faEducation(item.institution); return <article class="timeline-item reveal"><div class="timeline-date" dir="ltr">{item.startDate} — {faDate(item.endDate)}</div><div><h4>{copy.degree || [item.studyType, item.area].filter(Boolean).join(" · ")}</h4><p class="timeline-place">{copy.place}</p></div></article>; })}</div><h3 class="journey-subtitle">دوره‌ها و گواهی‌ها <span>{String(certificates.length).padStart(2, "0")}</span></h3><div class="certificate-list">{certificates.map((certificate) => <article class="certificate-item reveal"><div><h4>{faCertificate(certificate.name)}</h4><p>{faIssuer(certificate.issuer)}</p></div><span>{certificate.status === "Enrolled" ? "در حال گذراندن" : certificate.date}</span></article>)}</div></div></div>
      </section>

      <section class="section notes-section" id="notes" aria-labelledby="notes-title"><div class="section-heading reveal"><span class="section-num">۰۵ / یادداشت‌ها</span><span class="section-rule"></span><span class="section-aside">ایده و پیاده‌سازی</span></div><div class="section-title-row reveal"><div><p class="section-kicker">یادداشت‌های مهندسی</p><h2 id="notes-title" class="display-heading">فکرهایی پشت<br /><em>هر پروژه.</em></h2></div><p>نوشته‌های کوتاه و کاربردی دربارهٔ فناوری‌ها و تصمیم‌هایی که در پروژه‌هایم به کار برده‌ام.</p></div><div class="notes-grid">{topics.map((topic, index) => { const copy = faTopic(topic.slug); return <a class="note-item reveal" href={faTopicPath(topic.slug)}><span>{String(index + 1).padStart(2, "0")} / یادداشت</span><h3>{copy.title}</h3><p>{copy.description}</p><span class="note-arrow" aria-hidden="true">↗</span></a>; })}</div></section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-orbit" aria-hidden="true"></div><div class="contact-inner"><p class="section-kicker">۰۶ / ارتباط</p><h2 id="contact-title">ایده‌ای برای<br /><em>ساختن دارید؟</em></h2><p>دربارهٔ نرم‌افزار، سیستم‌ها و مسئله‌ای که می‌خواهید حل کنید گفت‌وگو کنیم.</p><a class="contact-email" href={`mailto:${basics.email}`}><bdi>{basics.email}</bdi> <span aria-hidden="true">↗</span></a><div class="contact-links">{basics.profiles?.map((profile) => <a href={profile.url} target="_blank" rel="me noopener noreferrer" dir="ltr">{profile.network} ↗</a>)}<a href="https://cv.sinafateh.ir/">رزومه ↗</a></div></div></section>
    </main>

    <footer class="site-footer"><div><a href="#top" class="footer-brand">{faName} <span>↗</span></a><p>از ایده تا کد و کاربرد واقعی.</p></div><div class="footer-right"><a href="/" lang="en" dir="ltr">English</a><span>© {new Date().getFullYear()} {faName}</span><a href="#top">بازگشت به بالا ↑</a></div></footer>
  </div>
</Layout>

<script>
  document.documentElement.classList.add("portfolio-enhanced");
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = document.querySelector<HTMLElement>(".mobile-nav");
  const closeMenu = () => { if (!menuButton || !mobileNav) return; menuButton.setAttribute("aria-expanded", "false"); menuButton.setAttribute("aria-label", "باز کردن فهرست"); mobileNav.hidden = true; };
  menuButton?.addEventListener("click", () => { if (!mobileNav) return; const opening = mobileNav.hidden; mobileNav.hidden = !opening; menuButton.setAttribute("aria-expanded", String(opening)); menuButton.setAttribute("aria-label", opening ? "بستن فهرست" : "باز کردن فهرست"); });
  mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
  const scene = document.querySelector<HTMLElement>("#architecture-scene");
  const sceneWrap = document.querySelector<HTMLElement>(".scene-wrap");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let frame = 0;
  if (scene && sceneWrap && finePointer.matches && !reducedMotion.matches) {
    sceneWrap.addEventListener("pointermove", (event) => { const rect = sceneWrap.getBoundingClientRect(); const x = (event.clientX - rect.left) / rect.width - 0.5; const y = (event.clientY - rect.top) / rect.height - 0.5; cancelAnimationFrame(frame); frame = requestAnimationFrame(() => { scene.style.setProperty("--scene-x", `${x * 14}deg`); scene.style.setProperty("--scene-y", `${y * -12}deg`); scene.style.setProperty("--light-x", `${(x + 0.5) * 100}%`); scene.style.setProperty("--light-y", `${(y + 0.5) * 100}%`); }); }, { passive: true });
    sceneWrap.addEventListener("pointerleave", () => { cancelAnimationFrame(frame); scene.style.setProperty("--scene-x", "0deg"); scene.style.setProperty("--scene-y", "0deg"); });
  }
  const revealItems = document.querySelectorAll<HTMLElement>(".portfolio-v2 .reveal");
  if ("IntersectionObserver" in window && !reducedMotion.matches) { const observer = new IntersectionObserver((entries) => { for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } }, { threshold: 0.06, rootMargin: "0px 0px -30px 0px" }); revealItems.forEach((item) => observer.observe(item)); }
  else revealItems.forEach((item) => item.classList.add("is-visible"));
</script>
