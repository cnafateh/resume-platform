---
import Layout from "../../../layouts/Layout.astro";
import { data } from "../../../data/resume";
import { personId, projects, siteUrl, topics } from "../../../data/seo";
import { faName, faProject, faProjectPath, faTopic, faTopicPath } from "../../../data/fa";
import "@fontsource-variable/vazirmatn/wght.css";
import "../../../styles/portfolio-experience.css";
import "../../../styles/portfolio-fa.css";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const copy = faTopic(topic.slug);
const related = projects.filter((project) => topic.related.some((slug) => slug === project.slug));
const canonical = `${siteUrl}${faTopicPath(topic.slug)}`;
const schema = {
  "@type": "Article",
  "@id": `${canonical}#article`,
  headline: copy.title,
  description: copy.description,
  author: { "@id": personId },
  mainEntityOfPage: canonical,
  inLanguage: "fa",
};
---

<Layout lang="fa" title={`${copy.title} | ${faName}`} description={copy.description} schema={schema} alternatePath={`/topics/${topic.slug}/`} bodyClass="portfolio-v2 editorial-page fa-detail">
  <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
  <header class="inner-header"><a class="inner-brand" href="/fa/">{faName}<span aria-hidden="true">✳</span></a><nav aria-label="ناوبری صفحه"><a href="/fa/#work">پروژه‌ها</a><a href={`/topics/${topic.slug}/`} lang="en" dir="ltr">English</a><a href={`mailto:${data.basics.email}`}>ارتباط ↗</a></nav></header>
  <main id="main-content" class="inner-main">
    <nav class="breadcrumbs" aria-label="مسیر صفحه"><a href="/fa/">خانه</a><span>/</span><a href="/fa/#notes">یادداشت‌ها</a><span>/</span><span aria-current="page">{copy.title}</span></nav>
    <article class="note-article"><p class="inner-eyebrow">یادداشت مهندسی / {String(topics.findIndex((item) => item.slug === topic.slug) + 1).padStart(2, "0")}</p><h1>{copy.title}</h1><p class="inner-lead">{copy.intro}</p><div class="note-questions">{copy.sections.map((section, index) => <section><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{section.heading}</h2><p>{section.body}</p></div></section>)}</div></article>
    <section class="inner-section" aria-labelledby="project-heading"><div class="inner-section-head"><span>در عمل</span><h2 id="project-heading">پروژه‌های مرتبط</h2></div><ul class="inner-link-list">{related.map((project) => <li><a href={faProjectPath(project.slug)}>{faProject(project.slug, project.name, project.description).title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>
    <section class="inner-section" aria-labelledby="more-heading"><div class="inner-section-head"><span>ادامهٔ مطالعه</span><h2 id="more-heading">یادداشت‌های دیگر</h2></div><ul class="inner-link-list">{topics.filter((item) => item.slug !== topic.slug).map((item) => <li><a href={faTopicPath(item.slug)}>{faTopic(item.slug).title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>
    <a class="inner-back" href="/fa/#notes">← بازگشت به یادداشت‌ها</a>
  </main>
  <footer class="inner-footer"><span>{faName}</span><a href="/fa/">بازگشت به صفحهٔ اصلی ↗</a></footer>
</Layout>
