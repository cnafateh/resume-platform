---
import Layout from "../../../layouts/Layout.astro";
import { data } from "../../../data/resume";
import { personId, projects, topics, siteUrl } from "../../../data/seo";
import { faName, faProject, faProjectPath, faTopic, faTopicPath } from "../../../data/fa";
import "@fontsource-variable/vazirmatn/wght.css";
import "../../../styles/portfolio-experience.css";
import "../../../styles/portfolio-fa.css";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const copy = faProject(project.slug, project.name, project.description);
const canonical = `${siteUrl}${faProjectPath(project.slug)}`;
const related = projects.filter((item) => item.slug !== project.slug && item.keywords?.some((keyword) => project.keywords?.includes(keyword))).slice(0, 3);
const matchingTopics = topics.filter((topic) => topic.related.some((slug) => slug === project.slug));
const schema = {
  "@type": "CreativeWork",
  "@id": `${canonical}#project`,
  name: copy.title,
  description: copy.description,
  url: canonical,
  inLanguage: "fa",
  author: { "@id": personId },
  keywords: project.keywords?.join(", "),
  ...(project.links?.github ? { codeRepository: project.links.github } : {}),
  ...(project.links?.live ? { sameAs: project.links.live } : {}),
};
---

<Layout lang="fa" title={`${copy.title} | ${faName}`} description={copy.description} schema={schema} alternatePath={project.href} bodyClass="portfolio-v2 editorial-page fa-detail">
  <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
  <header class="inner-header"><a class="inner-brand" href="/fa/">{faName}<span aria-hidden="true">✳</span></a><nav aria-label="ناوبری صفحه"><a href="/fa/#work">همهٔ پروژه‌ها</a><a href={project.href} lang="en" dir="ltr">English</a><a href={`mailto:${data.basics.email}`}>ارتباط ↗</a></nav></header>
  <main id="main-content" class="inner-main">
    <nav class="breadcrumbs" aria-label="مسیر صفحه"><a href="/fa/">خانه</a><span>/</span><a href="/fa/#work">پروژه‌ها</a><span>/</span><span aria-current="page">{copy.title}</span></nav>
    <div class="inner-hero"><div><p class="inner-eyebrow">پروژه / {String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, "0")}</p><h1>{copy.title}</h1><p class="inner-lead">{copy.description}</p><div class="inner-actions">{project.links?.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">رفتن به سایت پروژه ↗</a>}{project.links?.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">دیدن کد در گیت‌هاب ↗</a>}</div></div><div class="inner-art" aria-hidden="true"><span class="inner-art-ring"></span><span class="inner-art-core">{String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, "0")}</span><span class="inner-art-label">طراحی / توسعه / اجرا</span></div></div>
    {project.keywords?.length > 0 && <section class="inner-section" aria-labelledby="stack-heading"><div class="inner-section-head"><span>۰۱ / فناوری</span><h2 id="stack-heading">فناوری‌های این پروژه</h2></div><ul class="inner-tags">{project.keywords.map((keyword) => <li dir="ltr">{keyword}</li>)}</ul></section>}
    {matchingTopics.length > 0 && <section class="inner-section" aria-labelledby="topics-heading"><div class="inner-section-head"><span>۰۲ / بیشتر بخوانید</span><h2 id="topics-heading">یادداشت‌های مرتبط</h2></div><ul class="inner-link-list">{matchingTopics.map((topic) => <li><a href={faTopicPath(topic.slug)}>{faTopic(topic.slug).title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    {related.length > 0 && <section class="inner-section" aria-labelledby="related-heading"><div class="inner-section-head"><span>۰۳ / پروژه‌های دیگر</span><h2 id="related-heading">پروژه‌های مرتبط</h2></div><ul class="inner-link-list">{related.map((item) => <li><a href={faProjectPath(item.slug)}>{faProject(item.slug, item.name, item.description).title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    <a class="inner-back" href="/fa/#work">← دیدن همهٔ پروژه‌ها</a>
  </main>
  <footer class="inner-footer"><span>{faName}</span><a href="/fa/">برگشت به خانه ↗</a></footer>
</Layout>
