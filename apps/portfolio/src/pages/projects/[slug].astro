---
import Layout from "../../layouts/Layout.astro";
import { personId, projects, topics, siteUrl } from "../../data/seo";
import { data } from "../../data/resume";
import "../../styles/portfolio-experience.css";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const canonical = `${siteUrl}${project.href}`;
const related = projects.filter((item) => item.slug !== project.slug && item.keywords?.some((keyword) => project.keywords?.includes(keyword))).slice(0, 3);
const matchingTopics = topics.filter((topic) => topic.related.some((slug) => slug === project.slug));
const schema = {
  "@type": "CreativeWork",
  "@id": `${canonical}#project`,
  name: project.name,
  description: project.description,
  url: canonical,
  author: { "@id": personId },
  keywords: project.keywords?.join(", "),
  ...(project.links?.github ? { codeRepository: project.links.github } : {}),
  ...(project.links?.live ? { sameAs: project.links.live } : {}),
};
---

<Layout title={`${project.name} | ${data.basics.name}`} description={`${project.description.slice(0, 150)}…`} schema={schema} bodyClass="portfolio-v2 editorial-page">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="inner-header"><a class="inner-brand" href="/">{data.basics.name}<span aria-hidden="true">✳</span></a><nav aria-label="Page navigation"><a href="/#work">All work</a><a href="https://cv.sinafateh.ir/">CV ↗</a><a href={`mailto:${data.basics.email}`}>Contact ↗</a></nav></header>
  <main id="main-content" class="inner-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#work">Work</a><span>/</span><span aria-current="page">{project.name}</span></nav>
    <div class="inner-hero"><div><p class="inner-eyebrow">PROJECT / {String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, "0")}</p><h1>{project.name}</h1><p class="inner-lead">{project.description}</p><div class="inner-actions">{project.links?.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">View live project ↗</a>}{project.links?.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">Explore source ↗</a>}</div></div><div class="inner-art" aria-hidden="true"><span class="inner-art-ring"></span><span class="inner-art-core">{String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, "0")}</span><span class="inner-art-label">DESIGN / BUILD / SHIP</span></div></div>
    {project.keywords?.length > 0 && <section class="inner-section" aria-labelledby="stack-heading"><div class="inner-section-head"><span>01 / TECHNOLOGY</span><h2 id="stack-heading">Tools & focus</h2></div><ul class="inner-tags">{project.keywords.map((keyword) => <li>{keyword}</li>)}</ul></section>}
    {matchingTopics.length > 0 && <section class="inner-section" aria-labelledby="topics-heading"><div class="inner-section-head"><span>02 / EXPLORE</span><h2 id="topics-heading">Related engineering notes</h2></div><ul class="inner-link-list">{matchingTopics.map((topic) => <li><a href={`/topics/${topic.slug}/`}>{topic.title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    {related.length > 0 && <section class="inner-section" aria-labelledby="related-heading"><div class="inner-section-head"><span>03 / NEXT</span><h2 id="related-heading">Related projects</h2></div><ul class="inner-link-list">{related.map((item) => <li><a href={item.href}>{item.name}<span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    <a class="inner-back" href="/#work">← Explore all work</a>
  </main>
  <footer class="inner-footer"><span>{data.basics.name}</span><a href="/">Back to portfolio ↗</a></footer>
</Layout>
