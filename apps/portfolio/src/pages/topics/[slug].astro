---
import Layout from "../../layouts/Layout.astro";
import { personId, projects, siteUrl, topics } from "../../data/seo";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const related = projects.filter((project) => topic.related.some((slug) => slug === project.slug));
const schema = {
  "@type": "Article",
  "@id": `${siteUrl}/topics/${topic.slug}/#article`,
  headline: topic.title,
  description: topic.description,
  author: { "@id": personId },
  mainEntityOfPage: `${siteUrl}/topics/${topic.slug}/`,
  inLanguage: "en",
};
---

<Layout title={`${topic.title} | Sina Fateh`} description={topic.description} schema={schema}>
  <main class="section-shell py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-neutral-500"><a href="/" class="underline">Sina Fateh</a> <span aria-hidden="true">/</span> {topic.title}</nav>
    <article class="mt-12 max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-widest text-neutral-500">Engineering notes by Sina Fateh</p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight md:text-5xl">{topic.title}</h1>
      <p class="mt-7 text-lg leading-9 text-neutral-600 dark:text-neutral-400">{topic.intro}</p>
      <div class="mt-12 space-y-10">{topic.sections.map((section) => <section><h2 class="text-2xl font-semibold">{section.heading}</h2><p class="mt-3 leading-8 text-neutral-600 dark:text-neutral-400">{section.body}</p></section>)}</div>
    </article>
    <section class="mt-16" aria-labelledby="project-heading"><h2 id="project-heading" class="text-2xl font-semibold">Projects that show this work</h2><ul class="mt-5 grid gap-3 md:grid-cols-2">{related.map((project) => <li><a class="block rounded-2xl border border-black/10 p-5 underline dark:border-white/10" href={project.href}>{project.name}</a></li>)}</ul></section>
    <section class="mt-16" aria-labelledby="more-heading"><h2 id="more-heading" class="text-2xl font-semibold">More from Sina Fateh</h2><ul class="mt-5 flex flex-wrap gap-5">{topics.filter((item) => item.slug !== topic.slug).map((item) => <li><a class="underline" href={`/topics/${item.slug}/`}>{item.title}</a></li>)}</ul></section>
    <p class="mt-16 text-sm"><a class="underline" href="/">← Sina Fateh portfolio</a></p>
  </main>
</Layout>
