---
import Layout from "../../layouts/Layout.astro";
import { personId, projects, siteUrl, topics } from "../../data/seo";
import { data } from "../../data/resume";
import "../../styles/portfolio-experience.css";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const related = projects.filter((project) => topic.related.some((slug) => slug === project.slug));
const schema = {
  "@type": "Article",
  "@id": `${siteUrl}/topics/${topic.slug}/#article`,
  headline: topic.title,
  description: topic.description,
  author: { "@id": personId },
  mainEntityOfPage: `${siteUrl}/topics/${topic.slug}/`,
  inLanguage: "en",
};
---

<Layout title={`${topic.title} | ${data.basics.name}`} description={topic.description} schema={schema} bodyClass="portfolio-v2 editorial-page">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="inner-header"><a class="inner-brand" href="/">{data.basics.name}<span aria-hidden="true">✳</span></a><nav aria-label="Page navigation"><a href="/#work">Projects</a><a href="https://cv.sinafateh.ir/">CV ↗</a><a href={`mailto:${data.basics.email}`}>Contact ↗</a></nav></header>
  <main id="main-content" class="inner-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">{topic.title}</span></nav>
    <article class="note-article"><p class="inner-eyebrow">ENGINEERING NOTE / {String(topics.findIndex((item) => item.slug === topic.slug) + 1).padStart(2, "0")}</p><h1>{topic.title}</h1><p class="inner-lead">{topic.intro}</p><div class="note-questions">{topic.sections.map((section, index) => <section><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{section.heading}</h2><p>{section.body}</p></div></section>)}</div></article>
    <section class="inner-section" aria-labelledby="project-heading"><div class="inner-section-head"><span>IN PRACTICE</span><h2 id="project-heading">Related projects</h2></div><ul class="inner-link-list">{related.map((project) => <li><a href={project.href}>{project.name}<span aria-hidden="true">↗</span></a></li>)}</ul></section>
    <section class="inner-section" aria-labelledby="more-heading"><div class="inner-section-head"><span>CONTINUE READING</span><h2 id="more-heading">More notes</h2></div><ul class="inner-link-list">{topics.filter((item) => item.slug !== topic.slug).map((item) => <li><a href={`/topics/${item.slug}/`}>{item.title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>
    <a class="inner-back" href="/">← Back to portfolio</a>
  </main>
  <footer class="inner-footer"><span>{data.basics.name}</span><a href="/">Back to portfolio ↗</a></footer>
</Layout>
